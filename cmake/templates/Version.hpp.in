#pragma once

#include <string_view>

/**
 * @file CnaTemplate/Version.hpp
 * @brief The cna-template release a translation unit is compiled against.
 *
 * Generated by cmake/CnaTemplateVersion.cmake from cmake/templates/Version.hpp.in. The version
 * itself is decided in one place only -- project(CnaTemplate VERSION ...) and
 * CNA_TEMPLATE_VERSION_PRERELEASE in the root CMakeLists.txt (see docs/releasing.md). Never
 * edit the generated copy in the build tree.
 *
 * This is the template's (your game's) own version. The CNA release underneath has its own,
 * in <CNA/Version.hpp> (CNA::getVersionString()), and the two move independently.
 */

/** @brief Major component of the release, as a preprocessor-testable integer literal. */
#define CNA_TEMPLATE_VERSION_MAJOR @PROJECT_VERSION_MAJOR@

/** @brief Minor component of the release, as a preprocessor-testable integer literal. */
#define CNA_TEMPLATE_VERSION_MINOR @PROJECT_VERSION_MINOR@

/** @brief Patch component of the release, as a preprocessor-testable integer literal. */
#define CNA_TEMPLATE_VERSION_PATCH @PROJECT_VERSION_PATCH@

/** @brief Pre-release identifier without its leading '-'; an empty string on a final release. */
#define CNA_TEMPLATE_VERSION_PRERELEASE "@CNA_TEMPLATE_VERSION_PRERELEASE@"

/** @brief The complete release string, e.g. "0.1.0" or "0.2.0-beta.1"; no leading 'v'. */
#define CNA_TEMPLATE_VERSION_STRING "@CNA_TEMPLATE_VERSION_STRING@"

namespace CnaTemplate {

/** @brief The major component of the release being compiled against. */
[[nodiscard]] constexpr int getVersionMajor() noexcept { return CNA_TEMPLATE_VERSION_MAJOR; }

/** @brief The minor component of the release being compiled against. */
[[nodiscard]] constexpr int getVersionMinor() noexcept { return CNA_TEMPLATE_VERSION_MINOR; }

/** @brief The patch component of the release being compiled against. */
[[nodiscard]] constexpr int getVersionPatch() noexcept { return CNA_TEMPLATE_VERSION_PATCH; }

/** @brief The pre-release identifier ("beta.1" for 0.2.0-beta.1), empty on a final release. */
[[nodiscard]] constexpr std::string_view getVersionPreRelease() noexcept {
    return CNA_TEMPLATE_VERSION_PRERELEASE;
}

/** @brief The complete release string in Semantic Versioning spelling, e.g. "0.1.0". */
[[nodiscard]] constexpr std::string_view getVersionString() noexcept {
    return CNA_TEMPLATE_VERSION_STRING;
}

/** @brief True for an alpha, beta or release-candidate build, false on a final release. */
[[nodiscard]] constexpr bool isPreReleaseVersion() noexcept { return !getVersionPreRelease().empty(); }

}  // namespace CnaTemplate
