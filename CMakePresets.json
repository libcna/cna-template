{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "web-base",
      "hidden": true,
      "inherits": "release",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
    },
    {
      "name": "mingw-base",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-w64.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "sdl-renderer",
      "displayName": "SDL_RENDERER \u2014 Most portable renderer, and CNA's default off Linux",
      "description": "2D renderer. Platforms: linux, windows, macos, android. Dependency: none.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "SDL_RENDERER"
      }
    },
    {
      "name": "sdl-gpu",
      "displayName": "SDL_GPU \u2014 SDL3's own GPU abstraction",
      "description": "2D3D renderer. Platforms: linux, windows, macos. Dependency: system libshaderc.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "SDL_GPU"
      }
    },
    {
      "name": "opengles3",
      "displayName": "OPENGLES3 \u2014 CNA's default renderer on Linux",
      "description": "2D3D renderer. Platforms: linux, windows, macos, android. Dependency: sibling ../easy-gl (which needs ../meta-gl).",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "OPENGLES3"
      }
    },
    {
      "name": "opengles2",
      "displayName": "OPENGLES2 \u2014 Internally EasyGL, GLES 2.0 profile",
      "description": "2D3D renderer. Platforms: linux, windows, macos, android. Dependency: sibling ../easy-gl (which needs ../meta-gl).",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "OPENGLES2"
      }
    },
    {
      "name": "opengl33",
      "displayName": "OPENGL33 \u2014 Internally EasyGL, desktop GL 3.3 core profile",
      "description": "2D3D renderer. Platforms: linux, windows, macos. Dependency: sibling ../easy-gl (which needs ../meta-gl).",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "OPENGL33"
      }
    },
    {
      "name": "web-webgl2",
      "displayName": "WEBGL2 \u2014 CNA's default renderer under Emscripten",
      "description": "2D3D renderer. Platforms: web. Dependency: sibling ../easy-gl (which needs ../meta-gl).",
      "inherits": "web-base",
      "binaryDir": "${sourceDir}/build-probe",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "WEBGL2"
      }
    },
    {
      "name": "web-webgl1",
      "displayName": "WEBGL1 \u2014 WebGL 1 profile",
      "description": "2D3D renderer. Platforms: web. Dependency: sibling ../easy-gl (which needs ../meta-gl).",
      "inherits": "web-base",
      "binaryDir": "${sourceDir}/build-probe",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "WEBGL1"
      }
    },
    {
      "name": "opengl4",
      "displayName": "OPENGL4 \u2014 Real desktop OpenGL 4.x core profile, independent of EasyGL",
      "description": "2D3D renderer. Platforms: linux, windows, macos. Dependency: system OpenGL.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "OPENGL4"
      }
    },
    {
      "name": "vulkan",
      "displayName": "VULKAN \u2014 Real 3D via Vulkan",
      "description": "2D3D renderer. Platforms: linux, windows. Dependency: system Vulkan SDK (find_package(Vulkan REQUIRED)).",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "VULKAN"
      }
    },
    {
      "name": "webgpu",
      "displayName": "WEBGPU \u2014 Despite the name this is a NATIVE renderer; CNA rejects it under Emscripten",
      "description": "2D3D renderer. Platforms: linux, windows, macos. Dependency: wgpu-native binary release, auto-downloaded.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "WEBGPU"
      }
    },
    {
      "name": "metal",
      "displayName": "METAL \u2014 macOS only",
      "description": "2D3D renderer. Platforms: macos. Dependency: Apple Metal framework.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "METAL"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "headless",
      "displayName": "HEADLESS \u2014 No GPU and no window at all",
      "description": "2D3D renderer. Platforms: linux, windows, macos, android. Dependency: none.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "HEADLESS"
      }
    },
    {
      "name": "software",
      "displayName": "SOFTWARE \u2014 Real CPU rasterizer",
      "description": "2D3D renderer. Platforms: linux, windows, macos, android. Dependency: none.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "SOFTWARE"
      }
    },
    {
      "name": "stub",
      "displayName": "STUB \u2014 Deliberate no-op renderer",
      "description": "2D3D renderer. Platforms: linux, windows, macos, android. Dependency: none.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "STUB"
      }
    },
    {
      "name": "web-canvas",
      "displayName": "CANVAS \u2014 Browser 2D canvas context",
      "description": "2D renderer. Platforms: web. Dependency: none.",
      "inherits": "web-base",
      "binaryDir": "${sourceDir}/build-probe",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "CANVAS"
      }
    },
    {
      "name": "web-html-dom",
      "displayName": "HTML_DOM \u2014 Draws sprites as pooled CSS-transformed <div> elements",
      "description": "2D renderer. Platforms: web. Dependency: none.",
      "inherits": "web-base",
      "binaryDir": "${sourceDir}/build-probe",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "HTML_DOM"
      }
    },
    {
      "name": "web-svg-dom",
      "displayName": "SVG_DOM \u2014 Draws sprites as real <svg>/<image> elements",
      "description": "2D renderer. Platforms: web. Dependency: none.",
      "inherits": "web-base",
      "binaryDir": "${sourceDir}/build-probe",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "SVG_DOM"
      }
    },
    {
      "name": "fna3d",
      "displayName": "FNA3D \u2014 The XNA-shaped C library FNA renders through",
      "description": "2D3D renderer. Platforms: linux, windows, macos. Dependency: FNA3D + MojoShader via FetchContent; needs Python3.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "FNA3D"
      }
    },
    {
      "name": "windows-gdi",
      "displayName": "GDI \u2014 Classic Win32 GDI, 2D only",
      "description": "2D renderer. Platforms: windows. Dependency: Win32 GDI.",
      "inherits": "mingw-base",
      "binaryDir": "${sourceDir}/build-consumer",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "GDI"
      }
    },
    {
      "name": "windows-directx11",
      "displayName": "DIRECTX11 \u2014 Direct3D 11",
      "description": "2D3D renderer. Platforms: windows. Dependency: d3d11.h/dxgi.h.",
      "inherits": "mingw-base",
      "binaryDir": "${sourceDir}/build-consumer",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "DIRECTX11"
      }
    },
    {
      "name": "windows-directx12",
      "displayName": "DIRECTX12 \u2014 Direct3D 12",
      "description": "2D3D renderer. Platforms: windows. Dependency: d3d12.h/dxgi.h.",
      "inherits": "mingw-base",
      "binaryDir": "${sourceDir}/build-consumer",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "DIRECTX12"
      }
    },
    {
      "name": "windows-directx9",
      "displayName": "DIRECTX9 \u2014 Direct3D 9",
      "description": "2D3D renderer. Platforms: windows. Dependency: d3d9.h.",
      "inherits": "mingw-base",
      "binaryDir": "${sourceDir}/build-consumer",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "DIRECTX9"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "sdl-renderer",
      "configurePreset": "sdl-renderer"
    },
    {
      "name": "sdl-gpu",
      "configurePreset": "sdl-gpu"
    },
    {
      "name": "opengles3",
      "configurePreset": "opengles3"
    },
    {
      "name": "opengles2",
      "configurePreset": "opengles2"
    },
    {
      "name": "opengl33",
      "configurePreset": "opengl33"
    },
    {
      "name": "web-webgl2",
      "configurePreset": "web-webgl2"
    },
    {
      "name": "web-webgl1",
      "configurePreset": "web-webgl1"
    },
    {
      "name": "opengl4",
      "configurePreset": "opengl4"
    },
    {
      "name": "vulkan",
      "configurePreset": "vulkan"
    },
    {
      "name": "webgpu",
      "configurePreset": "webgpu"
    },
    {
      "name": "metal",
      "configurePreset": "metal"
    },
    {
      "name": "headless",
      "configurePreset": "headless"
    },
    {
      "name": "software",
      "configurePreset": "software"
    },
    {
      "name": "stub",
      "configurePreset": "stub"
    },
    {
      "name": "web-canvas",
      "configurePreset": "web-canvas"
    },
    {
      "name": "web-html-dom",
      "configurePreset": "web-html-dom"
    },
    {
      "name": "web-svg-dom",
      "configurePreset": "web-svg-dom"
    },
    {
      "name": "fna3d",
      "configurePreset": "fna3d"
    },
    {
      "name": "windows-gdi",
      "configurePreset": "windows-gdi"
    },
    {
      "name": "windows-directx11",
      "configurePreset": "windows-directx11"
    },
    {
      "name": "windows-directx12",
      "configurePreset": "windows-directx12"
    },
    {
      "name": "windows-directx9",
      "configurePreset": "windows-directx9"
    }
  ],
  "testPresets": [
    {
      "name": "sdl-renderer",
      "configurePreset": "sdl-renderer",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "display"
        }
      }
    },
    {
      "name": "sdl-gpu",
      "configurePreset": "sdl-gpu",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "display"
        }
      }
    },
    {
      "name": "opengles3",
      "configurePreset": "opengles3",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "display"
        }
      }
    },
