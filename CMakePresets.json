{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "web-base",
      "hidden": true,
      "inherits": "release",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
    },
    {
      "name": "mingw-base",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-w64.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "sdlgpu",
      "displayName": "SDLGPU (native)",
      "description": "2D3D renderer. Platforms: linux, windows, macos. Dependency: none.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/sdlgpu",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "SDLGPU"
      },
      "condition": {
        "type": "anyOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Linux"
          },
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Windows"
          },
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Darwin"
          }
        ]
      }
    },
    {
      "name": "windows-msvc-sdlgpu",
      "displayName": "SDLGPU (windows-msvc)",
      "description": "2D3D renderer. Platforms: linux, windows, macos. Dependency: none.",
      "inherits": "msvc-base",
      "binaryDir": "${sourceDir}/build/windows-msvc-sdlgpu",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "SDLGPU"
      }
    },
    {
      "name": "opengles3",
      "displayName": "OPENGLES3 (native)",
      "description": "2D3D renderer. Platforms: linux, windows, macos, android. Dependency: sibling ../easy-gl (which needs ../meta-gl).",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/opengles3",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "OPENGLES3"
      },
      "condition": {
        "type": "anyOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Linux"
          },
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Windows"
          },
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Darwin"
          }
        ]
      }
    },
    {
      "name": "opengl33",
      "displayName": "OPENGL33 (native)",
      "description": "2D3D renderer. Platforms: linux, windows, macos. Dependency: sibling ../easy-gl (which needs ../meta-gl).",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/opengl33",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "OPENGL33"
      },
      "condition": {
        "type": "anyOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Linux"
          },
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Windows"
          },
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Darwin"
          }
        ]
      }
    },
    {
      "name": "web-webgl2",
      "displayName": "WEBGL2 (web)",
      "description": "2D3D renderer. Platforms: web. Dependency: sibling ../easy-gl (which needs ../meta-gl).",
      "inherits": "web-base",
      "binaryDir": "${sourceDir}/build/web-webgl2",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "WEBGL2"
      }
    },
    {
      "name": "webgpu",
      "displayName": "WEBGPU (native)",
      "description": "2D3D renderer. Platforms: linux, windows, macos, web. Dependency: wgpu-native binary release, auto-downloaded.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/webgpu",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "WEBGPU"
      },
      "condition": {
        "type": "anyOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Linux"
          },
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Windows"
          },
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Darwin"
          }
        ]
      }
    },
    {
      "name": "web-webgpu",
      "displayName": "WEBGPU (web)",
      "description": "2D3D renderer. Platforms: linux, windows, macos, web. Dependency: wgpu-native binary release, auto-downloaded.",
      "inherits": "web-base",
      "binaryDir": "${sourceDir}/build/web-webgpu",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "WEBGPU"
      }
    },
    {
      "name": "headless",
      "displayName": "HEADLESS (native)",
      "description": "2D3D renderer. Platforms: linux, windows, macos, android. Dependency: none.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/headless",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "HEADLESS"
      },
      "condition": {
        "type": "anyOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Linux"
          },
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Windows"
          },
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Darwin"
          }
        ]
      }
    },
    {
      "name": "software",
      "displayName": "SOFTWARE (native)",
      "description": "2D3D renderer. Platforms: linux, windows, macos, android. Dependency: none.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/software",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "SOFTWARE"
      },
      "condition": {
        "type": "anyOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Linux"
          },
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Windows"
          },
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Darwin"
          }
        ]
      }
    },
    {
      "name": "stub",
      "displayName": "STUB (native)",
      "description": "2D3D renderer. Platforms: linux, windows, macos, android. Dependency: none.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/stub",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "STUB"
      },
      "condition": {
        "type": "anyOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Linux"
          },
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Windows"
          },
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Darwin"
          }
        ]
      }
    },
    {
      "name": "fna3d",
      "displayName": "FNA3D (native)",
      "description": "2D3D renderer. Platforms: linux, windows, macos. Dependency: FNA3D + MojoShader via FetchContent; needs Python3.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/fna3d",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "FNA3D"
      },
      "condition": {
        "type": "anyOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Linux"
          },
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Windows"
          },
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Darwin"
          }
        ]
      }
    },
    {
      "name": "windows-mingw-directx9",
      "displayName": "DIRECTX9 (windows-mingw)",
      "description": "2D3D renderer. Platforms: windows. Dependency: d3d9.h.",
      "inherits": "mingw-base",
      "binaryDir": "${sourceDir}/build/windows-mingw-directx9",
      "cacheVariables": {
        "CNA_GRAPHICS_RENDERER": "DIRECTX9"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "sdlgpu",
      "configurePreset": "sdlgpu"
    },
    {
      "name": "windows-msvc-sdlgpu",
      "configurePreset": "windows-msvc-sdlgpu",
      "configuration": "Debug"
    },
    {
      "name": "opengles3",
      "configurePreset": "opengles3"
    },
    {
      "name": "opengl33",
      "configurePreset": "opengl33"
    },
    {
      "name": "web-webgl2",
      "configurePreset": "web-webgl2"
    },
    {
      "name": "webgpu",
      "configurePreset": "webgpu"
    },
    {
      "name": "web-webgpu",
      "configurePreset": "web-webgpu"
    },
    {
      "name": "headless",
      "configurePreset": "headless"
    },
    {
      "name": "software",
      "configurePreset": "software"
    },
    {
      "name": "stub",
      "configurePreset": "stub"
    },
    {
      "name": "fna3d",
      "configurePreset": "fna3d"
    },
    {
      "name": "windows-mingw-directx9",
      "configurePreset": "windows-mingw-directx9"
    }
  ],
  "testPresets": [
    {
      "name": "sdlgpu",
      "configurePreset": "sdlgpu",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "display"
        }
      }
    },
    {
      "name": "windows-msvc-sdlgpu",
      "configurePreset": "windows-msvc-sdlgpu",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "display"
        }
      },
      "configuration": "Debug"
    },
    {
      "name": "opengles3",
      "configurePreset": "opengles3",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "display"
        }
      }
    },
    {
      "name": "opengl33",
      "configurePreset": "opengl33",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "display"
        }
      }
    },
    {
      "name": "webgpu",
      "configurePreset": "webgpu",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "display"
        }
      }
    },
    {
      "name": "headless",
      "configurePreset": "headless",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "headless"
        }
      }
    },
    {
      "name": "software",
      "configurePreset": "software",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "headless"
        }
      }
    },
    {
      "name": "stub",
      "configurePreset": "stub",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "headless"
        }
      }
    },
    {
      "name": "fna3d",
      "configurePreset": "fna3d",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "display"
        }
      }
    }
  ]
}
